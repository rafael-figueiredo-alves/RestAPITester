@page "/"

@inject NavigationManager Navigation
@inject HttpClient Http
@inject ISpecRepository SpecRepository
@inject ITestSuiteRepository TestSuiteRepository
@inject IEnvironmentRepository EnvironmentRepository
@inject JsonFileExportService FileExportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.False">
    <MudText Typo="Typo.h4" Class="mb-4">Importar especificação OpenAPI</MudText>

    @if (_parseResult is null && _savedSpecs.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.Info">
            Bem-vindo! Comece importando um arquivo <code>.json</code> com a especificação OpenAPI da sua API,
            ou cole a URL dela abaixo.
        </MudAlert>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <label class="rat-upload-button">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
            Escolher arquivo OpenAPI (.json)
            <InputFile OnChange="OnFileSelected" accept=".json" class="rat-upload-input" />
        </label>
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Ou importar de uma URL</MudText>
        <div class="d-flex align-center" style="gap: 8px;">
            <MudTextField T="string" @bind-Value="_importUrl" Label="URL do OpenAPI (.json)" Class="flex-grow-1" />
            <MudButton Variant="Variant.Outlined" OnClick="ImportFromUrl">Importar</MudButton>
        </div>

        @if (_savedSpecs.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Especificações salvas</MudText>
            @foreach (var saved in _savedSpecs)
            {
                <MudChip T="string" Class="mb-1 mr-1" OnClick="@(() => LoadSavedSpec(saved))"
                          OnClose="@(() => DeleteSavedSpec(saved))">
                    @saved.Name
                </MudChip>
            }
        }
    </MudPaper>

    @if (_parseResult is not null)
    {
        @if (_currentSpec is not null)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ExportCurrentSpec" Class="mb-3">
                Exportar JSON da spec
            </MudButton>
        }

        @if (_sessionVariables.Count > 0)
        {
            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="d-block mb-1">Sessão do Workspace (variáveis capturadas manualmente)</MudText>
                @foreach (var kv in _sessionVariables)
                {
                    <MudChip T="string" Size="Size.Small" Class="mb-1 mr-1" OnClose="@(() => RemoveSessionVariable(kv.Key))">
                        @kv.Key = @kv.Value
                    </MudChip>
                }
            </MudPaper>
        }

        <MudGrid>
            <MudItem xs="4">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6">@_parseResult.Title (@_parseResult.Version)</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        @_parseResult.Endpoints.Count endpoint(s) encontrado(s)
                    </MudText>

                    <MudTextField T="string" Value="_treeSearch" ValueChanged="OnSearchChanged"
                                  Label="Buscar endpoint" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true" Margin="Margin.Dense" Class="mb-3" />

                    <MudTreeView T="string" Items="@_treeItems" Hover="true"
                                 SelectedValue="_selectedOperationId"
                                 SelectedValueChanged="OnEndpointSelected">
                        <ItemTemplate>
                            <MudTreeViewItem Value="@context.Value" Items="@context.Children" Text="@context.Text" Icon="@context.Icon" />
                        </ItemTemplate>
                    </MudTreeView>
                </MudPaper>
            </MudItem>

            <MudItem xs="8">
                @if (_selectedEndpoint is not null)
                {
                    <MudPaper Class="pa-4" Elevation="2" @onkeydown="OnPanelKeyDown">
                        <MudText Typo="Typo.h6" Class="d-flex align-center">
                            <MudChip T="string" Color="@MethodColor(_selectedEndpoint.Method)" Size="Size.Small" Class="mr-2">
                                @_selectedEndpoint.Method.ToString().ToUpper()
                            </MudChip>
                            @_selectedEndpoint.Path
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(_selectedEndpoint.Summary))
                        {
                            <MudText Typo="Typo.body2" Class="mb-3">@_selectedEndpoint.Summary</MudText>
                        }
                        @if (_selectedEndpoint.Responses.Count > 0)
                        {
                            <MudExpansionPanels Class="mb-3">
                                <MudExpansionPanel Text="Respostas esperadas (schema da spec)">
                                    @foreach (var response in _selectedEndpoint.Responses)
                                    {
                                        <MudText Typo="Typo.subtitle2" Class="mt-2">
                                            @response.StatusCode @(response.Description is not null ? $"— {response.Description}" : "")
                                        </MudText>
                                        @if (response.SchemaJson is not null)
                                        {
                                            <MudTextField T="string" Value="@FormattedResponseBody(response.SchemaJson)" Lines="6" ReadOnly="true"
                                                        Variant="Variant.Outlined" Class="mb-2" />
                                        }
                                    }
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }                        

                        @if (_environments.Count > 0)
                        {
                            <MudSelect T="Guid?" Label="Usar ambiente salvo" ValueChanged="OnEnvironmentQuickSelect" Margin="Margin.Dense" Class="mb-2">
                                @foreach (var env in _environments)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)env.Id)">@env.Name (@env.BaseUrl)</MudSelectItem>
                                }
                            </MudSelect>
                        }

                        <div class="d-flex align-center mb-3" style="gap: 8px;">
                            <MudTextField @bind-Value="_baseUrl" Label="URL base" Class="flex-grow-1" />
                            <MudButton Variant="Variant.Outlined" OnClick="TestConnection">Testar conexão</MudButton>
                        </div>

                        <MudSwitch @bind-Value="_useProxy" Label="Usar proxy local (contorna CORS)" Color="Color.Primary" Class="mb-2" />
                        @if (_useProxy)
                        {
                            <MudTextField @bind-Value="_proxyUrl" Label="URL do proxy" Class="mb-3" />
                        }

                        @if (_selectedEndpoint.Parameters.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Parâmetros</MudText>
                            @foreach (var param in _selectedEndpoint.Parameters)
                            {
                                <MudTextField T="string"
                                            Label="@ParamLabel(param)"
                                            Value="@GetParamValue(param.Name)"
                                            ValueChanged="@(v => SetParamValue(param.Name, v))"
                                            Required="@param.Required"
                                            Error="@(param.Required && string.IsNullOrWhiteSpace(GetParamValue(param.Name)))"
                                            ErrorText="Campo obrigatório"
                                            Class="mb-2" />
                            }
                        }

                        @if (_selectedEndpoint.RequestBody is not null)
                        {
                            var isJsonBody = _selectedEndpoint.RequestBody.ContentType.Contains("json", StringComparison.OrdinalIgnoreCase);
                            <MudText Typo="Typo.subtitle2" Class="mb-2 mt-3">
                                Corpo da requisição (@_selectedEndpoint.RequestBody.ContentType)
                            </MudText>
                            <MudTextField @bind-Value="_requestBodyJson" Lines="8" Variant="Variant.Outlined"
                                          HelperText="@(isJsonBody ? null : "Um campo por linha, no formato chave=valor")" />
                            @if (isJsonBody)
                            {
                                <MudButton Variant="Variant.Text" Class="mt-2" OnClick="GenerateFakeBody">
                                    Gerar dados fictícios
                                </MudButton>
                            }
                        }

                        <MudExpansionPanels Class="mt-3">
                            <MudExpansionPanel Text="Opções avançadas">
                                <MudSwitch @bind-Value="_followRedirects" Label="Seguir redirecionamentos (3xx)" Color="Color.Primary" Class="mb-2" />

                                <MudTextField @bind-Value="_extraHeadersText"
                                              Label="Headers extras (um por linha: Nome: Valor — use {{variavel}})"
                                              Lines="3" Variant="Variant.Outlined" />

                                @if (_executionResult is not null)
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">Capturar variável desta resposta</MudText>
                                    <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                                        <MudTextField T="string" @bind-Value="_captureVarName" Label="Nome da variável" Margin="Margin.Dense" />
                                        <MudSwitch @bind-Value="_captureFromHeader" Label="De header" Color="Color.Primary" />
                                        <MudTextField T="string" @bind-Value="_captureVarSource"
                                                      Label="@(_captureFromHeader ? "Nome do header (ex: ETag)" : "JSONPath (ex: $.token)")"
                                                      Margin="Margin.Dense" Class="flex-grow-1" />
                                        <MudButton Variant="Variant.Outlined" OnClick="CaptureFromLastResult">Capturar</MudButton>
                                    </div>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4 d-block"
                                OnClick="ExecuteEndpoint" Disabled="_executing || HasMissingRequiredParams">
                            Executar
                        </MudButton>
                        @if (HasMissingRequiredParams)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1 d-block">
                                Preencha os parâmetros obrigatórios antes de executar.
                            </MudText>
                        }

                        @if (_executionResult is not null)
                        {
                            <MudDivider Class="my-4" />
                            <MudText Typo="Typo.subtitle2">
                                Status: @_executionResult.StatusCode — @_executionResult.DurationMs ms
                            </MudText>
                            @if (_executionResult.ErrorMessage is not null)
                            {
                                <MudAlert Severity="Severity.Error" Class="mt-2">@ErrorMessageHelper.Friendly(_executionResult.ErrorMessage)</MudAlert>
                            }
                            <MudTextField T="string" Value="@(FormattedResponseBody(_executionResult.ResponseBody))" Lines="10" ReadOnly="true"
                                          Variant="Variant.Outlined" Class="mt-2" />

                            <div class="d-flex align-center mt-2" style="gap: 8px;">
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CopyResponseBody">Copiar resposta</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CopyCurl">Copiar como cURL</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ExportExecutionReport">Exportar relatório</MudButton>
                            </div>

                            @if (_executionResult.ResponseHeaders.Count > 0)
                            {
                                <MudExpansionPanels Class="mt-2">
                                    <MudExpansionPanel Text="@($"Headers da resposta ({_executionResult.ResponseHeaders.Count})")">
                                        <MudSimpleTable Dense="true" Hover="true">
                                            <thead>
                                                <tr><th>Header</th><th>Valor</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var header in _executionResult.ResponseHeaders)
                                                {
                                                    <tr><td>@header.Key</td><td>@header.Value</td></tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }                            

                            <MudDivider Class="my-4" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Salvar como teste</MudText>

                            <MudSelect T="string" Label="Suíte de testes" Value="_selectedSuiteId"
                                       ValueChanged="OnSuiteSelected" Class="mb-2">
                                @foreach (var suite in _testSuites)
                                {
                                    <MudSelectItem T="string" Value="@suite.Id.ToString()">
                                        @suite.Name (@suite.TestCases.Count teste(s))
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <div class="d-flex align-center mb-3" style="gap: 8px;">
                                <MudTextField T="string" @bind-Value="_newSuiteName" Label="Nova suíte" Class="flex-grow-1" />
                                <MudButton Variant="Variant.Outlined" OnClick="CreateNewSuite">Criar</MudButton>
                            </div>

                            @if (_selectedSuite is not null)
                            {
                                <MudNumericField T="int?" @bind-Value="_expectedStatusCode" Label="Status esperado" Class="mb-2" />
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveAsTestCase">
                                    Salvar como teste em "@_selectedSuite.Name"
                                </MudButton>
                            }
                        }
                    </MudPaper>
                }
                else
                {
                    <MudText Typo="Typo.body1" Class="mt-4">Selecione um endpoint na árvore ao lado.</MudText>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private ParseResult? _parseResult;
    private string? _errorMessage;
    private List<TreeItemData<string>> _treeItems = new();
    private string _treeSearch = string.Empty;
    private string _importUrl = string.Empty;

    private string? _selectedOperationId;
    private EndpointInfo? _selectedEndpoint;
    private string _baseUrl = string.Empty;
    private readonly Dictionary<string, string> _paramValues = new();
    private string? _requestBodyJson;
    private string _extraHeadersText = string.Empty;
    private bool _followRedirects = true;
    private bool _executing;
    private ExecutionResult? _executionResult;

    private bool _useProxy = true;
    private string _proxyUrl = string.Empty;

    private readonly Dictionary<string, string> _sessionVariables = new();
    private string _captureVarName = string.Empty;
    private string _captureVarSource = string.Empty;
    private bool _captureFromHeader;

    private List<SavedSpec> _savedSpecs = new();
    private SavedSpec? _currentSpec;
    private List<ApiEnvironment> _environments = new();

    private List<TestSuite> _testSuites = new();
    private string? _selectedSuiteId;
    private TestSuite? _selectedSuite;
    private string _newSuiteName = string.Empty;
    private int? _expectedStatusCode;

    private readonly SchemaFakeDataGenerator _dataGenerator = new();

    protected override async Task OnInitializedAsync()
    {
        _proxyUrl = Navigation.BaseUri.TrimEnd('/');
        _savedSpecs = await SpecRepository.GetAllAsync();
        _testSuites = await TestSuiteRepository.GetAllAsync();
        _environments = await EnvironmentRepository.GetAllAsync();

        var lastSpecId = await JS.InvokeAsync<string?>("localStorage.getItem", "restapitester-last-spec");
        if (Guid.TryParse(lastSpecId, out var specId))
        {
            var spec = _savedSpecs.FirstOrDefault(s => s.Id == specId);
            if (spec is not null)
            {
                await LoadSavedSpec(spec);

                var lastEndpoint = await JS.InvokeAsync<string?>("localStorage.getItem", "restapitester-last-endpoint");
                if (!string.IsNullOrEmpty(lastEndpoint))
                    await OnEndpointSelected(lastEndpoint);
            }
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _parseResult = null;
        _selectedEndpoint = null;
        _executionResult = null;

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var parser = new OpenApiParser();
            _parseResult = parser.Parse(content);

            if (_parseResult.HasErrors)
            {
                _errorMessage = string.Join("; ", _parseResult.Errors);
                return;
            }

            _baseUrl = _parseResult.Servers.FirstOrDefault() ?? string.Empty;
            BuildTree();
            await SaveCurrentSpec(content, e.File.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao importar: {ex.Message}";
        }
    }

    private async Task ImportFromUrl()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_importUrl)) return;

        try
        {
            var fetchUrl = _useProxy
                ? $"{_proxyUrl.TrimEnd('/')}/proxy?target={Uri.EscapeDataString(_importUrl)}"
                : _importUrl;

            var content = await Http.GetStringAsync(fetchUrl);

            var parser = new OpenApiParser();
            _parseResult = parser.Parse(content);

            if (_parseResult.HasErrors)
            {
                _errorMessage = string.Join("; ", _parseResult.Errors);
                return;
            }

            _baseUrl = _parseResult.Servers.FirstOrDefault() ?? string.Empty;
            BuildTree();

            var name = _importUrl.Split('/').LastOrDefault(s => !string.IsNullOrEmpty(s)) ?? "spec-remota.json";
            await SaveCurrentSpec(content, name);
            Snackbar.Add("Especificação importada da URL.", Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao importar da URL: {ex.Message}";
        }
    }

    private async Task SaveCurrentSpec(string content, string fileName)
    {
        _currentSpec = new SavedSpec { Name = fileName, RawJson = content };
        await SpecRepository.SaveAsync(_currentSpec);
        _savedSpecs = await SpecRepository.GetAllAsync();
        await JS.InvokeVoidAsync("localStorage.setItem", "restapitester-last-spec", _currentSpec.Id.ToString());
        Snackbar.Add($"Especificação \"{fileName}\" salva.", Severity.Success);
    }

    private async Task LoadSavedSpec(SavedSpec spec)
    {
        _errorMessage = null;
        var parser = new OpenApiParser();
        _parseResult = parser.Parse(spec.RawJson);
        _currentSpec = spec;

        if (_parseResult.HasErrors)
        {
            _errorMessage = string.Join("; ", _parseResult.Errors);
            return;
        }

        _baseUrl = _parseResult.Servers.FirstOrDefault() ?? string.Empty;
        BuildTree();
        await JS.InvokeVoidAsync("localStorage.setItem", "restapitester-last-spec", spec.Id.ToString());
    }

    private async Task DeleteSavedSpec(SavedSpec spec)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir especificação",
            $"Tem certeza que deseja excluir \"{spec.Name}\"? As suítes que dependem dela deixarão de funcionar.",
            yesText: "Excluir", noText: "Cancelar");

        if (confirmed != true) return;

        await SpecRepository.DeleteAsync(spec.Id);
        _savedSpecs = await SpecRepository.GetAllAsync();
        Snackbar.Add("Especificação excluída.", Severity.Info);
    }

    private async Task ExportCurrentSpec()
    {
        if (_currentSpec is null) return;
        await FileExportService.DownloadJsonAsync(_currentSpec.Name, _currentSpec.RawJson);
    }

    private void OnSearchChanged(string value)
    {
        _treeSearch = value;
        if (_parseResult is not null) BuildTree();
    }

    private void BuildTree()
    {
        var query = _parseResult!.Endpoints.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_treeSearch))
        {
            var term = _treeSearch.Trim();
            query = query.Where(e =>
                e.Path.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                e.OperationId.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (e.Summary?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _treeItems = query
            .GroupBy(e => e.Tags.FirstOrDefault() ?? "Sem tag")
            .Select(group => new TreeItemData<string>
            {
                Text = group.Key,
                Icon = Icons.Material.Filled.Folder,
                Expanded = true,
                Children = group.Select(endpoint => new TreeItemData<string>
                {
                    Value = endpoint.OperationId,
                    Text = $"{endpoint.Method.ToString().ToUpper()} {endpoint.Path}",
                    Icon = MethodIcon(endpoint.Method)
                }).ToList()
            })
            .ToList();
    }

    private async Task OnEndpointSelected(string? operationId)
    {
        _selectedOperationId = operationId;
        _selectedEndpoint = _parseResult?.Endpoints.FirstOrDefault(e => e.OperationId == operationId);
        _paramValues.Clear();
        _requestBodyJson = null;
        _extraHeadersText = string.Empty;
        _executionResult = null;
        _expectedStatusCode = null;
        await JS.InvokeVoidAsync("localStorage.setItem", "restapitester-last-endpoint", operationId ?? string.Empty);
    }

    private static string ParamLabel(ParameterInfo param) => $"{param.Name} ({param.Location})";

    private string GetParamValue(string name) => _paramValues.TryGetValue(name, out var v) ? v : string.Empty;
    private void SetParamValue(string name, string value) => _paramValues[name] = value;

    private void GenerateFakeBody()
    {
        if (_selectedEndpoint?.RequestBody?.SchemaJson is null) return;
        _requestBodyJson = _dataGenerator.GenerateJson(_selectedEndpoint.RequestBody.SchemaJson);
    }

    private Dictionary<string, string> ParseExtraHeaders()
    {
        var result = new Dictionary<string, string>();
        foreach (var line in _extraHeadersText.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = line.Split(':', 2);
            if (parts.Length == 2)
                result[parts[0].Trim()] = parts[1].Trim();
        }
        return result;
    }

    private async Task ExecuteEndpoint()
    {
        if (_selectedEndpoint is null) return;

        _executing = true;
        _executionResult = null;

        try
        {
            var testCase = new TestCase
            {
                EndpointOperationId = _selectedEndpoint.OperationId,
                RequestBodyJson = _requestBodyJson,
                ParameterValues = _paramValues.ToDictionary(kv => kv.Key, kv => (object?)kv.Value),
                ExtraHeaders = ParseExtraHeaders(),
                FollowRedirects = _followRedirects
            };

            var executor = new TestExecutor(Http);
            var (result, _) = await executor.ExecuteAsync(
                _selectedEndpoint, testCase, _baseUrl, _sessionVariables,
                _useProxy ? _proxyUrl : null);

            _executionResult = result;
            _expectedStatusCode = result.StatusCode;
        }
        finally
        {
            _executing = false;
        }
    }

    private async Task OnPanelKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter" && !_executing && !HasMissingRequiredParams)
            await ExecuteEndpoint();
    }

    private async Task TestConnection()
    {
        try
        {
            var targetUrl = _useProxy
                ? $"{_proxyUrl.TrimEnd('/')}/proxy?target={Uri.EscapeDataString(_baseUrl)}" +
                  (_followRedirects ? "" : "&followRedirects=false")
                : _baseUrl;

            var response = await Http.GetAsync(targetUrl);
            Snackbar.Add($"Conexão OK — status {(int)response.StatusCode}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Falha na conexão: {ex.Message}", Severity.Error);
        }
    }

    private void CaptureFromLastResult()
    {
        if (_executionResult is null || string.IsNullOrWhiteSpace(_captureVarName)) return;

        var value = _captureFromHeader
            ? _executionResult.ResponseHeaders.GetValueOrDefault(_captureVarSource)
            : JsonPathHelper.EvaluateFirst(_executionResult.ResponseBody, _captureVarSource);

        if (value is not null)
            _sessionVariables[_captureVarName] = value;
    }

    private void RemoveSessionVariable(string key) => _sessionVariables.Remove(key);

    private async Task CopyResponseBody()
    {
        if (_executionResult?.ResponseBody is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _executionResult.ResponseBody);
        Snackbar.Add("Resposta copiada.", Severity.Success);
    }

    private async Task CopyCurl()
    {
        if (_executionResult?.CurlCommand is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _executionResult.CurlCommand);
        Snackbar.Add("Comando cURL copiado.", Severity.Success);
    }

    private void OnSuiteSelected(string? id)
    {
        _selectedSuiteId = id;
        _selectedSuite = _testSuites.FirstOrDefault(s => s.Id.ToString() == id);
    }

    private async Task CreateNewSuite()
    {
        if (string.IsNullOrWhiteSpace(_newSuiteName)) return;

        var suite = new TestSuite
        {
            Name = _newSuiteName,
            SourceSpecId = _currentSpec?.Id ?? Guid.Empty,
            SourceOpenApiFileName = _currentSpec?.Name ?? string.Empty,
            BaseUrl = _baseUrl
        };

        await TestSuiteRepository.SaveAsync(suite);
        _testSuites = await TestSuiteRepository.GetAllAsync();
        _selectedSuiteId = suite.Id.ToString();
        _selectedSuite = suite;
        _newSuiteName = string.Empty;
        Snackbar.Add($"Suíte \"{suite.Name}\" criada.", Severity.Success);
    }

    private async Task SaveAsTestCase()
    {
        if (_selectedSuite is null || _selectedEndpoint is null) return;

        var testCase = new TestCase
        {
            Name = $"{_selectedEndpoint.Method.ToString().ToUpper()} {_selectedEndpoint.Path}",
            EndpointOperationId = _selectedEndpoint.OperationId,
            ParameterValues = _paramValues.ToDictionary(kv => kv.Key, kv => (object?)kv.Value),
            RequestBodyJson = _requestBodyJson,
            ExtraHeaders = ParseExtraHeaders(),
            FollowRedirects = _followRedirects,
            ExpectedStatusCode = _expectedStatusCode ?? _executionResult?.StatusCode
        };

        _selectedSuite.TestCases.Add(testCase);
        await TestSuiteRepository.UpdateAsync(_selectedSuite);

        _testSuites = await TestSuiteRepository.GetAllAsync();
        _selectedSuite = _testSuites.FirstOrDefault(s => s.Id == _selectedSuite.Id);
        _selectedSuiteId = _selectedSuite?.Id.ToString();
        Snackbar.Add("Teste salvo na suíte.", Severity.Success);
    }

    private static string MethodIcon(HttpMethodType method) => method switch
    {
        HttpMethodType.Get => Icons.Material.Filled.ArrowCircleDown,
        HttpMethodType.Post => Icons.Material.Filled.AddCircle,
        HttpMethodType.Put => Icons.Material.Filled.Edit,
        HttpMethodType.Patch => Icons.Material.Filled.Edit,
        HttpMethodType.Delete => Icons.Material.Filled.Delete,
        _ => Icons.Material.Filled.Circle
    };

    private static Color MethodColor(HttpMethodType method) => method switch
    {
        HttpMethodType.Get => Color.Info,
        HttpMethodType.Post => Color.Success,
        HttpMethodType.Put => Color.Warning,
        HttpMethodType.Patch => Color.Warning,
        HttpMethodType.Delete => Color.Error,
        _ => Color.Default
    };

    private bool HasMissingRequiredParams =>
        _selectedEndpoint?.Parameters.Any(p => p.Required && string.IsNullOrWhiteSpace(GetParamValue(p.Name))) ?? false;

    private async Task ExportExecutionReport()
    {
        if (_executionResult is null) return;
        var json = System.Text.Json.JsonSerializer.Serialize(_executionResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await FileExportService.DownloadJsonAsync($"execucao-{_selectedEndpoint?.OperationId}-{DateTime.Now:yyyyMMdd-HHmmss}.json", json);
        Snackbar.Add("Relatório exportado.", Severity.Success);
    }

    private void OnEnvironmentQuickSelect(Guid? envId)
    {
        var env = _environments.FirstOrDefault(e => e.Id == envId);
        if (env is null) return;

        _baseUrl = env.BaseUrl;
        foreach (var (key, value) in env.FixedVariables)
            _sessionVariables[key] = value;
    }    

    private string FormattedResponseBody(string? responseBody)
    {
        if (string.IsNullOrWhiteSpace(responseBody))
            return string.Empty;

            try
            {
                using var document = JsonDocument.Parse(responseBody);

                return JsonSerializer.Serialize(
                    document.RootElement,
                    new JsonSerializerOptions
                    {
                        WriteIndented = true
                    });
            }
            catch (JsonException)
            {
                // Não é JSON, então retorna o conteúdo original
                return responseBody;
            }
        }
    }
