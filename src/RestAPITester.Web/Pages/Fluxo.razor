@page "/fluxo"
@using Blazor.Diagrams
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Options
@using RestAPITester.Web.Workflow
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Fluxo (em construção)</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        Passo 3: arraste o item da paleta à esquerda pra dentro do canvas.
    </MudText>

    <MudGrid>
        <MudItem xs="2">
            <MudPaper Class="pa-3" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Paleta</MudText>
                <div class="workflow-palette-item"
                     draggable="true"
                     @ondragstart="@(() => _draggedNodeType = "api-call")">
                    <MudIcon Icon="@Icons.Material.Filled.Http" Size="MudBlazor.Size.Small" Class="mr-1" />
                    Chamada de API
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="10">
            <MudPaper Class="pa-2" Elevation="2" Style="height: 70vh; overflow: hidden;">
                <div @ref="_canvasContainer"
                     style="width: 100%; height: 100%;"
                     @ondragover:preventDefault="true"
                     @ondrop="OnDrop">
                    <CascadingValue Value="_diagram">
                        <DiagramCanvas />
                    </CascadingValue>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="ShowWorkflowJson">
        Ver JSON do fluxo (depuração)
    </MudButton>

    @if (_workflowJson is not null)
    {
        <MudTextField T="string" Value="@_workflowJson" Lines="14" ReadOnly="true" Variant="Variant.Outlined" Class="mt-2" />
    }    
</MudContainer>

@code {
    private BlazorDiagram _diagram = null!;
    private ElementReference _canvasContainer;
    private string? _draggedNodeType;

    protected override void OnInitialized()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            AllowPanning = true,
            GridSize = 20,
            Zoom = { Minimum = 0.25, Maximum = 2.0, Inverse = false }
        };

        _diagram = new BlazorDiagram(options);
        _diagram.RegisterComponent<ApiCallNodeModel, ApiCallNodeWidget>();

        var startNode = _diagram.Nodes.Add(new NodeModel(new Point(80, 100)));
        startNode.Title = "Início";
        startNode.AddPort(PortAlignment.Right);
    }

    private async Task OnDrop(DragEventArgs e)
    {
        if (_draggedNodeType is null) return;

        var rect = await JS.InvokeAsync<BoundingRect>("getBoundingRect", _canvasContainer);

        // Converte a posição do mouse (relativa à tela) pra posição dentro do
        // diagrama, descontando o quanto o canvas está "arrastado" (pan) e
        // ajustando pelo nível de zoom atual.
        var x = (e.ClientX - rect.Left - _diagram.Pan.X) / _diagram.Zoom;
        var y = (e.ClientY - rect.Top - _diagram.Pan.Y) / _diagram.Zoom;

        if (_draggedNodeType == "api-call")
        {
            AddApiCallNode(new Point(x, y));
        }

        _draggedNodeType = null;
    }

    private class BoundingRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
    }

    private string? _workflowJson;

    private void ShowWorkflowJson()
    {
        var workflow = BuildWorkflowDefinition();
        _workflowJson = System.Text.Json.JsonSerializer.Serialize(workflow, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    private WorkflowDefinition BuildWorkflowDefinition()
    {
        var workflow = new WorkflowDefinition { Name = "Fluxo de teste" };
        var nodeIdMap = new Dictionary<NodeModel, Guid>();

        foreach (var node in _diagram.Nodes)
        {
            WorkflowNode workflowNode;

            if (node is ApiCallNodeModel apiCallNode)
            {
                workflowNode = apiCallNode.WorkflowNode;
            }
            else
            {
                // Qualquer nó genérico (como o "Início") vira um WorkflowNode do tipo Start.
                workflowNode = new WorkflowNode
                {
                    Type = WorkflowNodeType.Start,
                    Title = node.Title ?? "Início"
                };
            }

            workflowNode.PositionX = node.Position.X;
            workflowNode.PositionY = node.Position.Y;

            workflow.Nodes.Add(workflowNode);
            nodeIdMap[node] = workflowNode.Id;
        }

        foreach (var link in _diagram.Links)
        {
            var sourceNode = GetNodeFromLinkEndpoint(link.Source.Model);
            var targetNode = GetNodeFromLinkEndpoint(link.Target.Model);

            if (sourceNode is null || targetNode is null) continue;
            if (!nodeIdMap.TryGetValue(sourceNode, out var sourceId)) continue;
            if (!nodeIdMap.TryGetValue(targetNode, out var targetId)) continue;

            workflow.Connections.Add(new WorkflowConnection
            {
                SourceNodeId = sourceId,
                TargetNodeId = targetId
            });
        }

        return workflow;
    }

    private static NodeModel? GetNodeFromLinkEndpoint(ILinkable? model) => model switch
    {
        NodeModel node => node,
        PortModel port => port.Parent,
        _ => null
    };

    private ApiCallNodeModel AddApiCallNode(Point position)
    {
        var node = _diagram.Nodes.Add(new ApiCallNodeModel(position));
        node.AddPort(PortAlignment.Left);
        node.AddPort(PortAlignment.Right);
        return node;
    }
}