    private void OnCanvasKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not ("Delete" or "Backspace")) return;

        var selectedLinks = _diagram.Links.Where(l => l.Selected).ToList();
        foreach (var link in selectedLinks)
            _diagram.Links.Remove(link);

        var selectedNodes = _diagram.Nodes.Where(n => n.Selected).ToList();
        foreach (var node in selectedNodes)
            _diagram.Nodes.Remove(node);
    }    

    private async Task DuplicateWorkflow()
    {
        if (_currentWorkflowId is null)
        {
            Snackbar.Add("Salve o fluxo antes de duplicar.", Severity.Warning);
            return;
        }

        var source = _workflows.FirstOrDefault(w => w.Id == _currentWorkflowId);
        if (source is null) return;

        var idMap = new Dictionary<Guid, Guid>();
        var clonedNodes = source.Nodes.Select(n =>
        {
            var clone = CloneWorkflowNode(n);
            idMap[n.Id] = clone.Id;
            return clone;
        }).ToList();

        var clonedConnections = source.Connections
            .Where(c => idMap.ContainsKey(c.SourceNodeId) && idMap.ContainsKey(c.TargetNodeId))
            .Select(c => new WorkflowConnection
            {
                SourceNodeId = idMap[c.SourceNodeId],
                TargetNodeId = idMap[c.TargetNodeId],
                Label = c.Label
            }).ToList();

        var clone = new WorkflowDefinition
        {
            Name = $"{source.Name} (cópia)",
            Description = source.Description,
            SourceSpecId = source.SourceSpecId,
            BaseUrl = source.BaseUrl,
            Nodes = clonedNodes,
            Connections = clonedConnections
        };

        await WorkflowRepository.SaveAsync(clone);
        _workflows = await WorkflowRepository.GetAllAsync();
        Snackbar.Add("Fluxo duplicado.", Severity.Success);
    }

    private static WorkflowNode CloneWorkflowNode(WorkflowNode source) => new()
    {
        Type = source.Type,
        Title = source.Title,
        PositionX = source.PositionX,
        PositionY = source.PositionY,
        ApiCallSpecId = source.ApiCallSpecId,
        DelayMilliseconds = source.DelayMilliseconds,
        ConditionJsonPath = source.ConditionJsonPath,
        ConditionExpectedValue = source.ConditionExpectedValue,
        LoopMaxIterations = source.LoopMaxIterations,
        SetVariableName = source.SetVariableName,
        SetVariableValue = source.SetVariableValue,
        ApiCallTestCase = source.ApiCallTestCase is null ? null : new TestCase
        {
            Name = source.ApiCallTestCase.Name,
            EndpointOperationId = source.ApiCallTestCase.EndpointOperationId,
            ParameterValues = new Dictionary<string, object?>(source.ApiCallTestCase.ParameterValues),
            RequestBodyJson = source.ApiCallTestCase.RequestBodyJson,
            ExpectedStatusCode = source.ApiCallTestCase.ExpectedStatusCode,
            FollowRedirects = source.ApiCallTestCase.FollowRedirects,
            ExtraHeaders = new Dictionary<string, string>(source.ApiCallTestCase.ExtraHeaders),
            Assertions = source.ApiCallTestCase.Assertions.Select(a => new TestAssertion
            {
                Type = a.Type, JsonPath = a.JsonPath, HeaderName = a.HeaderName, ExpectedValue = a.ExpectedValue
            }).ToList(),
            CapturedVariables = source.ApiCallTestCase.CapturedVariables.Select(c => new VariableCapture
            {
                VariableName = c.VariableName, JsonPath = c.JsonPath, SourceHeaderName = c.SourceHeaderName
            }).ToList()
        }
    };    

    private readonly Stack<string> _undoStack = new();
    private readonly Stack<string> _redoStack = new();

    private void PushUndoSnapshot()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(BuildWorkflowDefinition());
        _undoStack.Push(json);
        _redoStack.Clear(); // uma mudança nova invalida o "refazer" antigo
    }

    private void Undo()
    {
        if (_undoStack.Count == 0) return;

        var currentJson = System.Text.Json.JsonSerializer.Serialize(BuildWorkflowDefinition());
        _redoStack.Push(currentJson);

        var previous = System.Text.Json.JsonSerializer.Deserialize<WorkflowDefinition>(_undoStack.Pop())!;
        LoadWorkflowIntoCanvas(previous);
    }

    private void Redo()
    {
        if (_redoStack.Count == 0) return;

        var currentJson = System.Text.Json.JsonSerializer.Serialize(BuildWorkflowDefinition());
        _undoStack.Push(currentJson);

        var next = System.Text.Json.JsonSerializer.Deserialize<WorkflowDefinition>(_redoStack.Pop())!;
        LoadWorkflowIntoCanvas(next);
    }    

