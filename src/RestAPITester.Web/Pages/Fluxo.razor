    private async Task ImportFromSuite()
    {
        var suites = await TestSuiteRepository.GetAllAsync();
        if (suites.Count == 0)
        {
            Snackbar.Add("Nenhuma suíte salva encontrada.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ImportSuiteDialog> { { x => x.Suites, suites } };
        var dialogRef = await DialogService.ShowAsync<ImportSuiteDialog>("Importar de uma suíte", parameters);
        var result = await dialogRef.Result;

        if (result is null || result.Canceled || result.Data is not Guid suiteId) return;

        var suite = suites.FirstOrDefault(s => s.Id == suiteId);
        if (suite is null) return;

        var workflow = ConvertSuiteToWorkflow(suite);
        _currentWorkflowId = null;
        _workflowName = workflow.Name;
        _baseUrl = workflow.BaseUrl;
        LoadWorkflowIntoCanvas(workflow);
        Snackbar.Add("Suíte convertida — revise os nós e clique em Salvar quando estiver pronto.", Severity.Info);
    }

    private static WorkflowDefinition ConvertSuiteToWorkflow(TestSuite suite)
    {
        var workflow = new WorkflowDefinition
        {
            Name = $"{suite.Name} (importado da suíte)",
            SourceSpecId = suite.SourceSpecId,
            BaseUrl = suite.BaseUrl
        };

        var start = new WorkflowNode { Type = WorkflowNodeType.Start, Title = "Início", PositionX = 80, PositionY = 150 };
        workflow.Nodes.Add(start);

        var previous = start;
        var x = 360;

        foreach (var testCase in suite.TestCases)
        {
            var node = new WorkflowNode
            {
                Type = WorkflowNodeType.ApiCall,
                Title = testCase.Name,
                PositionX = x,
                PositionY = 150,
                ApiCallSpecId = suite.SourceSpecId,
                ApiCallTestCase = CloneTestCaseForWorkflow(testCase)
            };

            workflow.Nodes.Add(node);
            workflow.Connections.Add(new WorkflowConnection { SourceNodeId = previous.Id, TargetNodeId = node.Id });

            previous = node;
            x += 280;
        }

        return workflow;
    }

    private static TestCase CloneTestCaseForWorkflow(TestCase source) => new()
    {
        Name = source.Name,
        EndpointOperationId = source.EndpointOperationId,
        ParameterValues = new Dictionary<string, object?>(source.ParameterValues),
        RequestBodyJson = source.RequestBodyJson,
        ExpectedStatusCode = source.ExpectedStatusCode,
        FollowRedirects = source.FollowRedirects,
        ExtraHeaders = new Dictionary<string, string>(source.ExtraHeaders),
        Assertions = source.Assertions.Select(a => new TestAssertion
        {
            Type = a.Type, JsonPath = a.JsonPath, HeaderName = a.HeaderName, ExpectedValue = a.ExpectedValue
        }).ToList(),
        CapturedVariables = source.CapturedVariables.Select(c => new VariableCapture
        {
            VariableName = c.VariableName, JsonPath = c.JsonPath, SourceHeaderName = c.SourceHeaderName
        }).ToList()
    };

    private async Task OpenTemplateDialog()
    {
        var dialogRef = await DialogService.ShowAsync<WorkflowTemplateDialog>("Novo a partir de modelo");
        var result = await dialogRef.Result;

        if (result is null || result.Canceled || result.Data is not string key) return;

        var workflow = key switch
        {
            "login" => BuildLoginTemplate(),
            "pagination" => BuildPaginationTemplate(),
            _ => null
        };
        if (workflow is null) return;

        _currentWorkflowId = null;
        _workflowName = workflow.Name;
        _baseUrl = workflow.BaseUrl;
        LoadWorkflowIntoCanvas(workflow);
        Snackbar.Add("Modelo carregado — configure os endpoints e salve quando estiver pronto.", Severity.Info);
    }

    private static WorkflowDefinition BuildLoginTemplate()
    {
        var workflow = new WorkflowDefinition { Name = "Login + chamada autenticada" };

        var start = new WorkflowNode { Type = WorkflowNodeType.Start, Title = "Início", PositionX = 80, PositionY = 140 };
        var login = new WorkflowNode
        {
            Type = WorkflowNodeType.ApiCall,
            Title = "Login",
            PositionX = 360,
            PositionY = 140,
            ApiCallTestCase = new TestCase
            {
                CapturedVariables = [new VariableCapture { VariableName = "authToken", JsonPath = "$.token" }]
            }
        };
        var authenticated = new WorkflowNode
        {
            Type = WorkflowNodeType.ApiCall,
            Title = "Chamada autenticada",
            PositionX = 680,
            PositionY = 140,
            ApiCallTestCase = new TestCase
            {
                ExtraHeaders = new Dictionary<string, string> { ["Authorization"] = "Bearer {{authToken}}" }
            }
        };

        workflow.Nodes.AddRange([start, login, authenticated]);
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = start.Id, TargetNodeId = login.Id });
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = login.Id, TargetNodeId = authenticated.Id });

        return workflow;
    }

    private static WorkflowDefinition BuildPaginationTemplate()
    {
        var workflow = new WorkflowDefinition { Name = "Paginação com loop" };

        var start = new WorkflowNode { Type = WorkflowNodeType.Start, Title = "Início", PositionX = 80, PositionY = 200 };
        var loop = new WorkflowNode { Type = WorkflowNodeType.Loop, Title = "Repetir", LoopMaxIterations = 20, PositionX = 360, PositionY = 200 };
        var fetchPage = new WorkflowNode { Type = WorkflowNodeType.ApiCall, Title = "Buscar página", PositionX = 680, PositionY = 80 };
        var hasNext = new WorkflowNode
        {
            Type = WorkflowNodeType.Condition,
            Title = "Tem próxima página?",
            ConditionJsonPath = "$.hasNextPage",
            ConditionExpectedValue = "true",
            PositionX = 680,
            PositionY = 320
        };
        var done = new WorkflowNode { Type = WorkflowNodeType.Delay, Title = "Fim", DelayMilliseconds = 0, PositionX = 1000, PositionY = 200 };

        workflow.Nodes.AddRange([start, loop, fetchPage, hasNext, done]);
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = start.Id, TargetNodeId = loop.Id });
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = loop.Id, TargetNodeId = fetchPage.Id, Label = "Corpo" });
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = fetchPage.Id, TargetNodeId = hasNext.Id });
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = hasNext.Id, TargetNodeId = loop.Id, Label = "Sim" }); // tem próxima -> continua
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = hasNext.Id, TargetNodeId = done.Id, Label = "Não" }); // acabou -> sai cedo
        workflow.Connections.Add(new WorkflowConnection { SourceNodeId = loop.Id, TargetNodeId = done.Id, Label = "Fim" }); // estourou o máximo de iterações

        return workflow;
    }    
