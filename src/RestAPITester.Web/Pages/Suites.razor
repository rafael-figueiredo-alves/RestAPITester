@page "/suites"

@inject NavigationManager Navigation
@inject HttpClient Http
@inject ISpecRepository SpecRepository
@inject ITestSuiteRepository TestSuiteRepository
@inject IEnvironmentRepository EnvironmentRepository
@inject IExecutionHistoryRepository HistoryRepository
@inject JsonFileExportService FileExportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h4" Class="mb-4">Suítes de Teste</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Ambientes</MudText>
        @foreach (var env in _environments)
        {
            <MudChip T="string" Class="mb-1 mr-1" OnClose="@(() => DeleteEnvironment(env))">
                @env.Name (@env.BaseUrl)
            </MudChip>
        }
        <div class="d-flex align-center mt-2" style="gap: 8px;">
            <MudTextField T="string" @bind-Value="_newEnvName" Label="Nome (ex: Produção)" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_newEnvUrl" Label="URL base" Margin="Margin.Dense" Class="flex-grow-1" />
        </div>
        <MudTextField T="string" @bind-Value="_newEnvVariablesText"
                    Label="Variáveis fixas (opcional, uma por linha: nome=valor)"
                    Lines="2" Variant="Variant.Outlined" Class="mt-2" />
        <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="CreateEnvironment">Adicionar ambiente</MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Importar suíte (.json)</MudText>
        <label class="rat-upload-button">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
            Escolher arquivo de suíte (.json)
            <InputFile OnChange="OnSuiteFileSelected" accept=".json" class="rat-upload-input" />
        </label>
        @if (_importError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_importError</MudAlert>
        }
    </MudPaper>

    @if (_suites.Count == 0)
    {
        <MudText Typo="Typo.body1">Nenhuma suíte salva ainda. Crie uma na tela de Workspace ao executar um endpoint.</MudText>
    }

    @foreach (var suite in _suites)
    {
        <MudPaper Class="pa-4 mb-3" Elevation="2">
            <MudText Typo="Typo.h6">@suite.Name</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                @suite.TestCases.Count teste(s) — URL base: @suite.BaseUrl
                @if (suite.LastRunAt is not null)
                {
                    <text> — última execução: @suite.LastRunAt.Value.ToLocalTime()</text>
                }
            </MudText>

            <MudSelect T="Guid?" Label="Ambiente (opcional — sobrepõe a URL base da suíte)"
                    Value="@_selectedEnvironmentBySuite.GetValueOrDefault(suite.Id)"
                    ValueChanged="@(v => _selectedEnvironmentBySuite[suite.Id] = v)"
                    Margin="Margin.Dense" Class="mb-2">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Usar URL da suíte (@suite.BaseUrl)</MudSelectItem>
                @foreach (var env in _environments)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)env.Id)">
                        @env.Name (@env.BaseUrl)@(env.FixedVariables.Count > 0 ? $" — {env.FixedVariables.Count} var(s)" : "")
                    </MudSelectItem>
                }
            </MudSelect>

            <div class="d-flex align-center mb-2 flex-wrap" style="gap: 8px;">
                <MudSwitch @bind-Value="_useProxy" Label="Usar proxy local" Color="Color.Primary" />
                @if (_useProxy)
                {
                    <MudTextField T="string" @bind-Value="_proxyUrl" Label="URL do proxy" Margin="Margin.Dense" />
                }
                <MudSwitch T="bool" @bind-Value="_followRedirectsForConnectionTest" Label="Seguir redirecionamentos (teste de conexão)" Color="Color.Primary" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => TestConnection(suite))">
                    Testar conexão
                </MudButton>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(() => RunSuite(suite))" Disabled="_runningSuiteId == suite.Id">
                Executar suíte
            </MudButton>
            <MudButton Variant="Variant.Text" Class="ml-2" OnClick="@(() => ToggleExpand(suite))">
                @(_expandedSuites.GetValueOrDefault(suite.Id) ? "Ocultar testes" : "Ver testes")
            </MudButton>
            <MudButton Variant="Variant.Text" Class="ml-2" OnClick="@(() => ToggleHistory(suite))">
                @(_expandedHistory.GetValueOrDefault(suite.Id) ? "Ocultar histórico" : "Ver histórico")
            </MudButton>
            <MudButton Variant="Variant.Text" Class="ml-2" OnClick="@(() => ExportSuite(suite))">
                Exportar JSON
            </MudButton>
            <MudButton Variant="Variant.Text" Class="ml-2" OnClick="@(() => DuplicateSuite(suite))">
                Duplicar
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" Class="ml-2" OnClick="@(() => DeleteSuite(suite))">
                Excluir
            </MudButton>

            @if (_errorsBySuite.TryGetValue(suite.Id, out var error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@error</MudAlert>
            }

            @if (_expandedHistory.GetValueOrDefault(suite.Id))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Histórico de execuções (mais recentes primeiro)</MudText>

                @if (_historyBySuite.TryGetValue(suite.Id, out var history) && history.Count > 0)
                {
                    @foreach (var entry in history)
                    {
                        <div class="d-flex align-center mb-1" style="gap: 8px;">
                            <MudAlert Severity="@(entry.AllPassed ? Severity.Success : Severity.Error)" Dense="true" Class="flex-grow-1">
                                @entry.StartedAt.ToLocalTime() — @(entry.AllPassed ? "Tudo passou" : "Alguma falha")
                                — @entry.Results.Count(r => r.Success)/@entry.Results.Count teste(s) ok
                            </MudAlert>
                            <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                        OnClick="@(() => ExportExecutionReport(suite, entry))" />
                        </div>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2">Nenhuma execução registrada ainda.</MudText>
                }
            }

            @if (_expandedSuites.GetValueOrDefault(suite.Id))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Testes da suíte (ordem de execução)</MudText>

                @foreach (var testCase in suite.TestCases)
                {
                    <MudPaper Class="pa-2 mb-2" Outlined="true">
                        <div class="d-flex align-center" style="gap: 8px;">
                            <MudTextField T="string" Value="@testCase.Name" Label="Nome" Margin="Margin.Dense" Class="flex-grow-1"
                                          ValueChanged="@(v => UpdateTestCaseName(suite, testCase, v))" />
                            <MudNumericField T="int?" Value="@testCase.ExpectedStatusCode" Label="Status esperado" Margin="Margin.Dense"
                                             Style="width:140px" ValueChanged="@(v => UpdateExpectedStatus(suite, testCase, v))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                           OnClick="@(() => MoveTestCase(suite, testCase, -1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                           OnClick="@(() => MoveTestCase(suite, testCase, 1))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                           OnClick="@(() => DuplicateTestCase(suite, testCase))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemoveTestCase(suite, testCase))" />
                        </div>

                        <MudExpansionPanels Class="mt-2">
                            <MudExpansionPanel Text="Opções avançadas (variáveis, asserções e rede)">
                                <MudSwitch T="bool" Value="@testCase.FollowRedirects" Label="Seguir redirecionamentos (3xx)" Color="Color.Primary" Class="mb-2"
                                           ValueChanged="@(v => UpdateFollowRedirects(suite, testCase, v))" />

                                <MudText Typo="Typo.caption" Class="d-block mb-1">
                                    Variáveis capturadas (ex: token de login, ETag, pra reusar nos próximos testes)
                                </MudText>
                                @foreach (var capture in testCase.CapturedVariables.ToList())
                                {
                                    <div class="d-flex align-center mb-1 flex-wrap" style="gap: 8px;">
                                        <MudTextField T="string" Value="@capture.VariableName" Label="Nome da variável" Margin="Margin.Dense"
                                                      ValueChanged="@(v => UpdateCaptureName(suite, capture, v))" />
                                        <MudTextField T="string" Value="@capture.SourceHeaderName" Label="Header (opcional, ex: ETag)" Margin="Margin.Dense"
                                                      ValueChanged="@(v => UpdateCaptureHeader(suite, capture, v))" />
                                        <MudTextField T="string" Value="@capture.JsonPath" Label="JSONPath (se não usar header)" Margin="Margin.Dense" Class="flex-grow-1"
                                                      ValueChanged="@(v => UpdateCapturePath(suite, capture, v))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       OnClick="@(() => RemoveCapture(suite, testCase, capture))" />
                                    </div>
                                }
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => AddCapture(suite, testCase))">
                                    + Capturar variável
                                </MudButton>

                                <MudText Typo="Typo.caption" Class="d-block mt-4 mb-1">
                                    Asserções adicionais (além do status esperado acima)
                                </MudText>
                                @foreach (var assertion in testCase.Assertions.ToList())
                                {
                                    <div class="d-flex align-center mb-1 flex-wrap" style="gap: 8px;">
                                        <MudSelect T="AssertionType" Value="@assertion.Type"
                                                   ValueChanged="@(v => UpdateAssertionType(suite, assertion, v))"
                                                   Label="Tipo" Margin="Margin.Dense" Style="min-width:220px">
                                            @foreach (var type in _assertionTypes)
                                            {
                                                <MudSelectItem T="AssertionType" Value="@type">@AssertionTypeLabel(type)</MudSelectItem>
                                            }
                                        </MudSelect>

                                        @if (assertion.Type == AssertionType.JsonPathEquals)
                                        {
                                            <MudTextField T="string" Value="@assertion.JsonPath" Label="JSONPath" Margin="Margin.Dense"
                                                          ValueChanged="@(v => UpdateAssertionJsonPath(suite, assertion, v))" />
                                        }
                                        @if (assertion.Type == AssertionType.HeaderEquals)
                                        {
                                            <MudTextField T="string" Value="@assertion.HeaderName" Label="Nome do header" Margin="Margin.Dense"
                                                          ValueChanged="@(v => UpdateAssertionHeaderName(suite, assertion, v))" />
                                        }

                                        <MudTextField T="string" Value="@assertion.ExpectedValue"
                                                      Label="@(assertion.Type == AssertionType.ResponseTimeBelowMs ? "Máximo (ms)" : "Valor esperado")"
                                                      Margin="Margin.Dense" Class="flex-grow-1"
                                                      ValueChanged="@(v => UpdateAssertionExpectedValue(suite, assertion, v))" />

                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       OnClick="@(() => RemoveAssertion(suite, testCase, assertion))" />
                                    </div>
                                }
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => AddAssertion(suite, testCase))">
                                    + Adicionar asserção
                                </MudButton>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudPaper>
                }
            }

            @if (_results.TryGetValue(suite.Id, out var result))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    Resultado: @(result.AllPassed ? "Tudo passou ✅" : "Alguma falha ❌")
                </MudText>

                <MudButton Variant="Variant.Text" Size="Size.Small" Class="mb-2" OnClick="@(() => ExportExecutionReport(suite, result))">
                    Exportar relatório desta execução
                </MudButton>                

                @foreach (var testResult in result.Results)
                {
                    var tc = suite.TestCases.FirstOrDefault(t => t.Id == testResult.TestCaseId);
                    <MudAlert Severity="@(testResult.Success ? Severity.Success : Severity.Error)" Dense="true" Class="mb-1">
                        @(tc?.Name ?? testResult.TestCaseId.ToString()) — status @testResult.StatusCode — @testResult.DurationMs ms
                        @if (testResult.ErrorMessage is not null)
                        {
                            <text> — @ErrorMessageHelper.Friendly(testResult.ErrorMessage)</text>
                        }
                    </MudAlert>
                }
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private string _newEnvVariablesText = string.Empty;

    private static readonly AssertionType[] _assertionTypes = Enum.GetValues<AssertionType>()
        .Where(t => t != AssertionType.StatusCode)
        .ToArray();

    private List<TestSuite> _suites = new();
    private List<ApiEnvironment> _environments = new();
    private readonly Dictionary<Guid, TestSuiteExecutionResult> _results = new();
    private readonly Dictionary<Guid, List<TestSuiteExecutionResult>> _historyBySuite = new();
    private readonly Dictionary<Guid, string> _errorsBySuite = new();
    private readonly Dictionary<Guid, bool> _expandedSuites = new();
    private readonly Dictionary<Guid, bool> _expandedHistory = new();
    private readonly Dictionary<Guid, Guid?> _selectedEnvironmentBySuite = new();

    private ApiEnvironment? GetSelectedEnvironment(Guid suiteId) =>
        _selectedEnvironmentBySuite.TryGetValue(suiteId, out var envId) && envId.HasValue
            ? _environments.FirstOrDefault(e => e.Id == envId.Value)
            : null;
    private Guid? _runningSuiteId;

    private bool _useProxy = true;
    private string _proxyUrl = string.Empty;
    private bool _followRedirectsForConnectionTest = true;

    private string _newEnvName = string.Empty;
    private string _newEnvUrl = string.Empty;

    private string? _importError;

    protected override async Task OnInitializedAsync()
    {
        _proxyUrl = Navigation.BaseUri.TrimEnd('/');
        _suites = await TestSuiteRepository.GetAllAsync();
        _environments = await EnvironmentRepository.GetAllAsync();
    }

    private async Task CreateEnvironment()
    {
        if (string.IsNullOrWhiteSpace(_newEnvName) || string.IsNullOrWhiteSpace(_newEnvUrl)) return;

        var variables = new Dictionary<string, string>();
        foreach (var line in _newEnvVariablesText.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = line.Split('=', 2);
            if (parts.Length == 2)
                variables[parts[0].Trim()] = parts[1].Trim();
        }

        await EnvironmentRepository.SaveAsync(new ApiEnvironment { Name = _newEnvName, BaseUrl = _newEnvUrl, FixedVariables = variables });
        _environments = await EnvironmentRepository.GetAllAsync();
        _newEnvName = string.Empty;
        _newEnvUrl = string.Empty;
        _newEnvVariablesText = string.Empty;
        Snackbar.Add("Ambiente adicionado.", Severity.Success);
    }

    private async Task DeleteEnvironment(ApiEnvironment env)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir ambiente",
            $"Tem certeza que deseja excluir o ambiente \"{env.Name}\"?",
            yesText: "Excluir", noText: "Cancelar");

        if (confirmed != true) return;

        await EnvironmentRepository.DeleteAsync(env.Id);
        _environments = await EnvironmentRepository.GetAllAsync();
        Snackbar.Add("Ambiente excluído.", Severity.Info);
    }

    private void ToggleExpand(TestSuite suite)
    {
        _expandedSuites[suite.Id] = !_expandedSuites.GetValueOrDefault(suite.Id);
    }

    private async Task ToggleHistory(TestSuite suite)
    {
        var expanding = !_expandedHistory.GetValueOrDefault(suite.Id);
        _expandedHistory[suite.Id] = expanding;

        if (expanding && !_historyBySuite.ContainsKey(suite.Id))
        {
            _historyBySuite[suite.Id] = await HistoryRepository.GetBySuiteAsync(suite.Id);
        }
    }

    private Task PersistSuite(TestSuite suite) => TestSuiteRepository.UpdateAsync(suite);

    private async Task UpdateTestCaseName(TestSuite suite, TestCase testCase, string value)
    {
        testCase.Name = value;
        await PersistSuite(suite);
    }

    private async Task UpdateExpectedStatus(TestSuite suite, TestCase testCase, int? value)
    {
        testCase.ExpectedStatusCode = value;
        await PersistSuite(suite);
    }

    private async Task MoveTestCase(TestSuite suite, TestCase testCase, int direction)
    {
        var index = suite.TestCases.IndexOf(testCase);
        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= suite.TestCases.Count) return;

        suite.TestCases.RemoveAt(index);
        suite.TestCases.Insert(newIndex, testCase);
        await PersistSuite(suite);
    }

    private async Task RemoveTestCase(TestSuite suite, TestCase testCase)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remover teste",
            $"Remover o teste \"{testCase.Name}\" da suíte?",
            yesText: "Remover", noText: "Cancelar");

        if (confirmed != true) return;

        suite.TestCases.Remove(testCase);
        await PersistSuite(suite);
        Snackbar.Add("Teste removido.", Severity.Info);
    }

    private async Task UpdateFollowRedirects(TestSuite suite, TestCase testCase, bool value)
    {
        testCase.FollowRedirects = value;
        await PersistSuite(suite);
    }

    private async Task AddCapture(TestSuite suite, TestCase testCase)
    {
        testCase.CapturedVariables.Add(new VariableCapture { VariableName = "novaVariavel", JsonPath = "$." });
        await PersistSuite(suite);
    }

    private async Task UpdateCaptureName(TestSuite suite, VariableCapture capture, string value)
    {
        capture.VariableName = value;
        await PersistSuite(suite);
    }

    private async Task UpdateCaptureHeader(TestSuite suite, VariableCapture capture, string value)
    {
        capture.SourceHeaderName = string.IsNullOrWhiteSpace(value) ? null : value;
        await PersistSuite(suite);
    }

    private async Task UpdateCapturePath(TestSuite suite, VariableCapture capture, string value)
    {
        capture.JsonPath = value;
        await PersistSuite(suite);
    }

    private async Task RemoveCapture(TestSuite suite, TestCase testCase, VariableCapture capture)
    {
        testCase.CapturedVariables.Remove(capture);
        await PersistSuite(suite);
    }

    private static string AssertionTypeLabel(AssertionType type) => type switch
    {
        AssertionType.BodyContains => "Corpo contém",
        AssertionType.JsonPathEquals => "JSONPath igual a",
        AssertionType.HeaderEquals => "Header igual a",
        AssertionType.ResponseTimeBelowMs => "Tempo de resposta abaixo de (ms)",
        _ => type.ToString()
    };

    private async Task AddAssertion(TestSuite suite, TestCase testCase)
    {
        testCase.Assertions.Add(new TestAssertion { Type = AssertionType.BodyContains });
        await PersistSuite(suite);
    }

    private async Task RemoveAssertion(TestSuite suite, TestCase testCase, TestAssertion assertion)
    {
        testCase.Assertions.Remove(assertion);
        await PersistSuite(suite);
    }

    private async Task UpdateAssertionType(TestSuite suite, TestAssertion assertion, AssertionType value)
    {
        assertion.Type = value;
        await PersistSuite(suite);
    }

    private async Task UpdateAssertionJsonPath(TestSuite suite, TestAssertion assertion, string value)
    {
        assertion.JsonPath = value;
        await PersistSuite(suite);
    }

    private async Task UpdateAssertionHeaderName(TestSuite suite, TestAssertion assertion, string value)
    {
        assertion.HeaderName = value;
        await PersistSuite(suite);
    }

    private async Task UpdateAssertionExpectedValue(TestSuite suite, TestAssertion assertion, string value)
    {
        assertion.ExpectedValue = value;
        await PersistSuite(suite);
    }

    private async Task ExportSuite(TestSuite suite)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(suite, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });

        var fileName = $"{suite.Name.Replace(" ", "_")}.testsuite.json";
        await FileExportService.DownloadJsonAsync(fileName, json);
        Snackbar.Add("Suíte exportada.", Severity.Success);
    }

    private async Task OnSuiteFileSelected(InputFileChangeEventArgs e)
    {
        _importError = null;

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var imported = System.Text.Json.JsonSerializer.Deserialize<TestSuite>(content);

            if (imported is null)
            {
                _importError = "Não foi possível interpretar o arquivo como uma suíte de testes válida.";
                return;
            }

            imported.Id = Guid.NewGuid();
            imported.CreatedAt = DateTime.UtcNow;
            imported.LastRunAt = null;

            await TestSuiteRepository.SaveAsync(imported);
            _suites = await TestSuiteRepository.GetAllAsync();
            Snackbar.Add($"Suíte \"{imported.Name}\" importada.", Severity.Success);
        }
        catch (Exception ex)
        {
            _importError = $"Erro ao importar suíte: {ex.Message}";
        }
    }

    private async Task RunSuite(TestSuite suite)
    {
        _runningSuiteId = suite.Id;
        _errorsBySuite.Remove(suite.Id);

        try
        {
            var specs = await SpecRepository.GetAllAsync();
            var spec = suite.SourceSpecId != Guid.Empty
                ? specs.FirstOrDefault(s => s.Id == suite.SourceSpecId)
                : null;

            spec ??= specs.FirstOrDefault(s => s.Name == suite.SourceOpenApiFileName);

            if (spec is null)
            {
                _errorsBySuite[suite.Id] = $"Spec de origem '{suite.SourceOpenApiFileName}' não encontrada entre as specs salvas.";
                return;
            }

            var parser = new OpenApiParser();
            var parseResult = parser.Parse(spec.RawJson);

            var executor = new TestExecutor(Http);
            var runner = new TestSuiteRunner(executor);

            var selectedEnv = GetSelectedEnvironment(suite.Id);
            var result = await runner.RunAsync(
                suite, parseResult.Endpoints, _useProxy ? _proxyUrl : null,
                baseUrlOverride: selectedEnv?.BaseUrl,
                initialVariables: selectedEnv?.FixedVariables);
            _results[suite.Id] = result;

            await HistoryRepository.SaveAsync(result);
            _historyBySuite[suite.Id] = await HistoryRepository.GetBySuiteAsync(suite.Id);

            suite.LastRunAt = DateTime.UtcNow;
            await TestSuiteRepository.UpdateAsync(suite);

            Snackbar.Add(
                result.AllPassed ? "Suíte executada: tudo passou! ✅" : "Suíte executada: houve falhas. ❌",
                result.AllPassed ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _runningSuiteId = null;
        }
    }

    private async Task TestConnection(TestSuite suite)
    {
        var baseUrl = GetSelectedEnvironment(suite.Id)?.BaseUrl ?? suite.BaseUrl;

        try
        {
            var targetUrl = _useProxy
                ? $"{_proxyUrl.TrimEnd('/')}/proxy?target={Uri.EscapeDataString(baseUrl)}" +
                  (_followRedirectsForConnectionTest ? "" : "&followRedirects=false")
                : baseUrl;

            var response = await Http.GetAsync(targetUrl);
            Snackbar.Add($"Conexão OK — status {(int)response.StatusCode}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Falha na conexão: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSuite(TestSuite suite)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir suíte",
            $"Tem certeza que deseja excluir a suíte \"{suite.Name}\"? Essa ação não pode ser desfeita.",
            yesText: "Excluir", noText: "Cancelar");

        if (confirmed != true) return;

        await TestSuiteRepository.DeleteAsync(suite.Id);
        _suites = await TestSuiteRepository.GetAllAsync();
        _results.Remove(suite.Id);
        _errorsBySuite.Remove(suite.Id);
        Snackbar.Add("Suíte excluída.", Severity.Info);
    }

    private async Task DuplicateSuite(TestSuite suite)
    {
        var clone = new TestSuite
        {
            Name = $"{suite.Name} (cópia)",
            Description = suite.Description,
            SourceSpecId = suite.SourceSpecId,
            SourceOpenApiFileName = suite.SourceOpenApiFileName,
            BaseUrl = suite.BaseUrl,
            TestCases = suite.TestCases.Select(CloneTestCase).ToList()
        };

        await TestSuiteRepository.SaveAsync(clone);
        _suites = await TestSuiteRepository.GetAllAsync();
        Snackbar.Add("Suíte duplicada.", Severity.Success);
    }

    private async Task DuplicateTestCase(TestSuite suite, TestCase testCase)
    {
        var index = suite.TestCases.IndexOf(testCase);
        var clone = CloneTestCase(testCase);
        clone.Name = $"{testCase.Name} (cópia)";
        suite.TestCases.Insert(index + 1, clone);
        await PersistSuite(suite);
        Snackbar.Add("Teste duplicado.", Severity.Success);
    }

    private static TestCase CloneTestCase(TestCase source) => new()
    {
        Name = source.Name,
        EndpointOperationId = source.EndpointOperationId,
        ParameterValues = new Dictionary<string, object?>(source.ParameterValues),
        RequestBodyJson = source.RequestBodyJson,
        ExpectedStatusCode = source.ExpectedStatusCode,
        FollowRedirects = source.FollowRedirects,
        Assertions = source.Assertions.Select(a => new TestAssertion
        {
            Type = a.Type,
            JsonPath = a.JsonPath,
            HeaderName = a.HeaderName,
            ExpectedValue = a.ExpectedValue
        }).ToList(),
        CapturedVariables = source.CapturedVariables.Select(c => new VariableCapture
        {
            VariableName = c.VariableName,
            JsonPath = c.JsonPath,
            SourceHeaderName = c.SourceHeaderName
        }).ToList(),
        ExtraHeaders = new Dictionary<string, string>(source.ExtraHeaders)
    };

    private async Task ExportExecutionReport(TestSuite suite, TestSuiteExecutionResult result)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(result, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await FileExportService.DownloadJsonAsync($"relatorio-{suite.Name.Replace(" ", "_")}-{result.StartedAt:yyyyMMdd-HHmmss}.json", json);
        Snackbar.Add("Relatório exportado.", Severity.Success);
    }    
}
