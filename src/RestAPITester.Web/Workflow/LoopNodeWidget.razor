@using Blazor.Diagrams.Components.Renderers

<div class="workflow-node workflow-node--loop @(Node.IsExecuting ? "workflow-node--executing" : Node.ExecutionSucceeded ? "workflow-node--succeeded" : string.Empty)">
    <MudIcon Icon="@Icons.Material.Filled.Loop" Size="MudBlazor.Size.Small" Class="mr-1" />
    <div class="workflow-node__body">
        <div class="workflow-node__title">@Node.Title</div>
        <div class="workflow-node__subtitle">@Node.LoopSummary</div>
    </div>
    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="MudBlazor.Size.Small"
                   OnClick="@(() => Node.OnEditRequested?.Invoke())" />
    <span class="workflow-node__branch-label workflow-node__branch-label--loop-body">Corpo</span>
    <span class="workflow-node__branch-label workflow-node__branch-label--loop-exit">Fim</span>
    @foreach (var port in Node.Ports)
    {
        <PortRenderer @key="port" Port="port" Class="default" />
    }
</div>

@code {
    [Parameter] public LoopNodeModel Node { get; set; } = null!;
}