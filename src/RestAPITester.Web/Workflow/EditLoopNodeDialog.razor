<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="Nome do nó" @bind-Value="_title" Class="mb-2" />
        <MudNumericField T="int" Label="Repetir até (vezes)" @bind-Value="_maxIterations" Min="1" Class="mb-2"
                          HelperText="O corpo roda no máximo esta quantidade de vezes. Pra sair antes, coloque um nó de Condição dentro do corpo com um ramo apontando direto pro destino depois do loop." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public LoopNodeModel Node { get; set; } = null!;

    private string _title = string.Empty;
    private int _maxIterations = 5;

    protected override void OnInitialized()
    {
        _title = Node.WorkflowNode.Title;
        _maxIterations = Node.WorkflowNode.LoopMaxIterations;
    }

    private void Save() => MudDialog.Close(DialogResult.Ok((_title, _maxIterations)));
    private void Cancel() => MudDialog.Cancel();
}